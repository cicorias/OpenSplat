# Ubuntu 24.04 ARM64 — CPU-only build
# For native ARM64 hosts (AWS Graviton, Ampere, etc.) or Apple Silicon via QEMU.
# Uses nvidia/cuda arm64 runtime base for consistency with the CUDA variant.
#
# Build (on ARM64 host):
#   docker build -f Dockerfile.ubuntu24-arm64 -t opensplat:ubuntu24-arm64-cpu .
#
# Build (cross-compile from AMD64 host, requires buildx + QEMU):
#   docker buildx build --platform linux/arm64 \
#     -f Dockerfile.ubuntu24-arm64 -t opensplat:ubuntu24-arm64-cpu .
#
# Run:
#   docker run --rm -v ~/data:/data opensplat:ubuntu24-arm64-cpu \
#     opensplat /data/project -o /data/output.ply

ARG TORCH_VERSION=2.6.0
ARG CMAKE_BUILD_TYPE=Release

FROM --platform=linux/arm64 nvidia/cuda:12.4.1-runtime-ubuntu24.04

ARG TORCH_VERSION
ARG CMAKE_BUILD_TYPE

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /code

# Install build dependencies
RUN apt-get update && \
    apt-get install -y \
        build-essential \
        cmake \
        git \
        ninja-build \
        libopencv-dev \
        python3 \
        python3-pip \
        unzip \
        wget && \
    apt-get autoremove -y --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ARM64 CPU libtorch: prebuilt zips from pytorch.org do not cover aarch64 Linux.
# We install via pip and symlink the cmake package location.
RUN pip3 install --break-system-packages \
    "torch==${TORCH_VERSION}" \
    --index-url https://download.pytorch.org/whl/cpu

# Expose the libtorch path installed by pip so CMake can find it
ENV LIBTORCH_PATH=/usr/local/lib/python3.12/dist-packages/torch

# Copy source
COPY . ./

# Configure and build
RUN mkdir build && cd build && \
    cmake .. \
        -GNinja \
        -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
        -DCMAKE_PREFIX_PATH=${LIBTORCH_PATH} \
        -DCMAKE_INSTALL_PREFIX=/code/install \
        -DGPU_RUNTIME=CPU && \
    ninja && \
    ninja install

ENV PATH="/code/install/bin:${PATH}"
