# Ubuntu 24.04 AMD64 — CPU-only build
# No CUDA required. Uses nvidia/cuda runtime base for driver compatibility
# if the host has an NVIDIA GPU but we compile without CUDA support.
#
# Build:
#   docker build -f Dockerfile.ubuntu24-amd64 -t opensplat:ubuntu24-amd64-cpu .
#
# Run:
#   docker run --rm -v ~/data:/data opensplat:ubuntu24-amd64-cpu \
#     opensplat /data/project -o /data/output.ply

ARG TORCH_VERSION=2.6.0
ARG CMAKE_BUILD_TYPE=Release

FROM --platform=linux/amd64 nvidia/cuda:12.4.1-runtime-ubuntu24.04

ARG TORCH_VERSION
ARG CMAKE_BUILD_TYPE

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /code

# Install build dependencies
RUN apt-get update && \
    apt-get install -y \
        build-essential \
        cmake \
        git \
        ninja-build \
        libopencv-dev \
        python3 \
        python3-pip \
        unzip \
        wget && \
    apt-get autoremove -y --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Download CPU libtorch (cxx11 ABI)
RUN wget --no-check-certificate -nv \
    "https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-${TORCH_VERSION}%2Bcpu.zip" \
    -O libtorch.zip && \
    unzip -q libtorch.zip && \
    rm libtorch.zip

# Copy source
COPY . ./

# Configure and build
RUN mkdir build && cd build && \
    cmake .. \
        -GNinja \
        -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
        -DCMAKE_PREFIX_PATH=/code/libtorch \
        -DCMAKE_INSTALL_PREFIX=/code/install \
        -DGPU_RUNTIME=CPU && \
    ninja && \
    ninja install

ENV PATH="/code/install/bin:${PATH}"
