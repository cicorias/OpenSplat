# Ubuntu 24.04 ARM64 — CUDA build
# Targets NVIDIA Jetson / Grace ARM platforms with CUDA support.
# SM targets: Xavier (72), Orin (87), Thor/next-gen (90).
#
# NOTE: Standard PyTorch libtorch zips are AMD64-only.
#       This file installs torch via pip (which provides aarch64 CUDA wheels
#       for Jetson via NVIDIA's index) and locates the cmake package from there.
#       For non-Jetson ARM CUDA hardware you may need to build PyTorch from source.
#
# Build (on ARM64 CUDA host or via buildx):
#   docker build -f Dockerfile.ubuntu24-arm64-cuda \
#     -t opensplat:ubuntu24-arm64-cuda .
#
# Run (requires NVIDIA Jetson or ARM CUDA hardware + nvidia-container-toolkit):
#   docker run --rm --gpus all -v ~/data:/data opensplat:ubuntu24-arm64-cuda \
#     opensplat /data/project -o /data/output.ply

ARG CUDA_VERSION=12.4.1
ARG TORCH_VERSION=2.6.0
ARG CMAKE_CUDA_ARCHITECTURES=72;87;90
ARG CMAKE_BUILD_TYPE=Release

FROM --platform=linux/arm64 nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04

ARG CUDA_VERSION
ARG TORCH_VERSION
ARG CMAKE_CUDA_ARCHITECTURES
ARG CMAKE_BUILD_TYPE

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /code

# Install build dependencies
RUN apt-get update && \
    apt-get install -y \
        build-essential \
        cmake \
        git \
        ninja-build \
        libopencv-dev \
        python3 \
        python3-pip \
        unzip \
        wget && \
    apt-get autoremove -y --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install torch for aarch64 via NVIDIA's Jetson pip index.
# For non-Jetson ARM CUDA, replace the index URL with the standard pytorch.org CUDA wheel URL.
RUN CUDA_MAJOR=$(echo ${CUDA_VERSION} | cut -d'.' -f1) && \
    CUDA_MINOR=$(echo ${CUDA_VERSION} | cut -d'.' -f2) && \
    CUDA_TAG="cu${CUDA_MAJOR}${CUDA_MINOR}" && \
    pip3 install --break-system-packages \
        "torch==${TORCH_VERSION}" \
        --index-url "https://download.pytorch.org/whl/${CUDA_TAG}"

# Locate the pip-installed libtorch cmake files
ENV LIBTORCH_PATH=/usr/local/lib/python3.12/dist-packages/torch

# Copy source
COPY . ./

# Configure and build
RUN mkdir build && cd build && \
    cmake .. \
        -GNinja \
        -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
        -DCMAKE_PREFIX_PATH=${LIBTORCH_PATH} \
        -DCMAKE_INSTALL_PREFIX=/code/install \
        -DGPU_RUNTIME=CUDA \
        -DCMAKE_CUDA_ARCHITECTURES="${CMAKE_CUDA_ARCHITECTURES}" \
        -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda && \
    ninja && \
    ninja install

ENV PATH="/code/install/bin:${PATH}"
