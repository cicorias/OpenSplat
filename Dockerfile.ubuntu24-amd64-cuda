# Ubuntu 24.04 AMD64 — CUDA build
# Full NVIDIA GPU acceleration. Base image includes CUDA devel headers + nvcc.
# SM targets cover Volta (70), Turing (75), Ampere (80,86), Ada (89), Hopper (90).
#
# Build:
#   docker build -f Dockerfile.ubuntu24-amd64-cuda \
#     -t opensplat:ubuntu24-amd64-cuda .
#
# Build with custom CUDA/torch versions:
#   docker build -f Dockerfile.ubuntu24-amd64-cuda \
#     --build-arg CUDA_VERSION=12.4.1 \
#     --build-arg TORCH_VERSION=2.6.0 \
#     --build-arg CMAKE_CUDA_ARCHITECTURES="80;86;89;90" \
#     -t opensplat:ubuntu24-amd64-cuda .
#
# Run (requires NVIDIA driver + nvidia-container-toolkit on host):
#   docker run --rm --gpus all -v ~/data:/data opensplat:ubuntu24-amd64-cuda \
#     opensplat /data/project -o /data/output.ply

ARG CUDA_VERSION=12.4.1
ARG TORCH_VERSION=2.6.0
ARG CMAKE_CUDA_ARCHITECTURES=70;75;80;86;89;90
ARG CMAKE_BUILD_TYPE=Release

FROM --platform=linux/amd64 nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04

ARG CUDA_VERSION
ARG TORCH_VERSION
ARG CMAKE_CUDA_ARCHITECTURES
ARG CMAKE_BUILD_TYPE

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /code

# Install build dependencies
RUN apt-get update && \
    apt-get install -y \
        build-essential \
        cmake \
        git \
        ninja-build \
        libopencv-dev \
        unzip \
        wget && \
    apt-get autoremove -y --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Derive short CUDA tag (e.g. 12.4.1 -> cu124) for libtorch URL
RUN CUDA_MAJOR=$(echo ${CUDA_VERSION} | cut -d'.' -f1) && \
    CUDA_MINOR=$(echo ${CUDA_VERSION} | cut -d'.' -f2) && \
    CUDA_TAG="cu${CUDA_MAJOR}${CUDA_MINOR}" && \
    echo "CUDA_TAG=${CUDA_TAG}" >> /etc/environment && \
    wget --no-check-certificate -nv \
    "https://download.pytorch.org/libtorch/${CUDA_TAG}/libtorch-cxx11-abi-shared-with-deps-${TORCH_VERSION}%2B${CUDA_TAG}.zip" \
    -O libtorch.zip && \
    unzip -q libtorch.zip && \
    rm libtorch.zip

# Copy source
COPY . ./

# Configure and build
RUN source /etc/environment && \
    mkdir build && cd build && \
    cmake .. \
        -GNinja \
        -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
        -DCMAKE_PREFIX_PATH=/code/libtorch \
        -DCMAKE_INSTALL_PREFIX=/code/install \
        -DGPU_RUNTIME=CUDA \
        -DCMAKE_CUDA_ARCHITECTURES="${CMAKE_CUDA_ARCHITECTURES}" \
        -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda && \
    ninja && \
    ninja install

ENV PATH="/code/install/bin:${PATH}"
